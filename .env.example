# Copie para .env (desenvolvimento) ou cadastre no Easypanel (aba Environment).
# NUNCA faça commit do .env com valores reais.

# Senha de acesso ao Jarvis (API e interface). Gere com: openssl rand -hex 24
JARVIS_ACCESS_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Opcional: outro endpoint compatível com a OpenAI (ex.: Ollama com modelo local)
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_MODEL=gemma4:e4b
# LLM_API_KEY=           # chave do endpoint acima, se ele exigir (a OPENAI_API_KEY não é enviada para ele)

# Voz (usa a mesma chave da OpenAI por padrão)
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Vozes: onyx (grave), alloy, echo, fable, nova, shimmer
OPENAI_TTS_VOICE=onyx
# OPENAI_VOICE_API_KEY=   # só se quiser usar outra chave para a voz

# Cérebro no Obsidian (vault em um repositório Git privado)
# BRAIN_GIT_URL=https://github.com/ampliize/ampliize-brain.git
# BRAIN_GIT_TOKEN=        # token do GitHub com Contents: read/write só nesse repositório
# BRAIN_SYNC_MINUTES=5

# CRM da Ampliize (gere a chave no CRM: Monitor → Chaves de API)
AMPLIIZE_API_URL=https://eiqkinagduvfbiayiqtr.supabase.co/functions/v1/integration-api
AMPLIIZE_API_KEY=

# Outros projetos (mesmo contrato da integration-api), em JSON:
# JARVIS_PROJECTS=[{"id":"bateponto","name":"Bate-ponto","url":"https://.../integration-api","key":"...","description":"Controle de ponto"}]
JARVIS_PROJECTS=

# Opcionais
JARVIS_OWNER_NAME=Davy
# Cidade padrão do clima (habilidade clima e card do bom dia)
JARVIS_CITY=Aracaju
# Origens liberadas para um frontend separado (separe por vírgula)
JARVIS_CORS_ORIGINS=
PORT=3000
DATA_DIR=./data
